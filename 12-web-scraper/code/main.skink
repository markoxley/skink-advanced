module main

import "scraper"
import "std/io"
import "std/os"
import "std/str"
import "std/strconv"

// usage prints the command synopsis.
fn usage() {
    io.PrintLine("usage: scrape <url> <regex-pattern> [--save hits.db]")
}

fn main() -> int {
    args := os.Args()
    if len(args) < 3 {
        usage()
        return 1
    }
    url := args[1]
    pattern := args[2]
    dsn := ""
    if len(args) >= 5 && str.Equal(args[3], "--save") {
        dsn = args[4]
    }

    body, ferr := scraper.FetchURL(url)
    if ferr.message != "" {
        io.PrintErrorLine(str.Concat("fetch failed: ", ferr.message))
        return 1
    }
    hits, xerr := scraper.Extract(pattern, body)
    if xerr.message != "" {
        io.PrintErrorLine(str.Concat("bad pattern: ", xerr.message))
        return 1
    }
    for h in hits {
        io.PrintLine(h)
    }
    io.PrintLine(str.Concat(strconv.Itoa(len(hits)), " match(es)"))

    if str.Len(dsn) > 0 {
        serr := scraper.SaveHits(dsn, url, hits)
        if serr.message != "" {
            io.PrintErrorLine(str.Concat("save failed: ", serr.message))
            return 1
        }
        io.PrintLine(str.Concat("saved to ", dsn))
    }
    return 0
}
