module main

import "std/fmt"
import "std/sync"
import "std/time"

// Global state watched by the static ruleset.
var currentTemp: float = 20.0

fn SetTemperature(t: float) {
    currentTemp = t
}

// SensorSource is a dynamic rule source. It implements the RuleSource template
// (name, start, stop, triggered, Action, Priority) so it can be registered with
// a ruleset at runtime. Methods are defined inside the struct so the compiler
// emits them with the qualified names the ruleset wrapper expects.
struct SensorSource {
    mu: *sync.Mutex
    reading: float
    threshold: float

    pub fn NewSensorSource(threshold: float) -> SensorSource {
        return SensorSource{
            mu: sync.NewMutex(),
            reading: 0.0,
            threshold: threshold,
        }
    }

    pub fn SetReading(self: *SensorSource, r: float) {
        self.mu.Lock()
        self.reading = r
        self.mu.Unlock()
    }

    pub fn name(self: *SensorSource) -> string {
        return "sensor_source"
    }

    pub fn start(self: *SensorSource) {
        // A real source would start background sampling here.
    }

    pub fn stop(self: *SensorSource) {
        // A real source would stop background sampling here.
    }

    pub fn triggered(self: *SensorSource) -> bool {
        self.mu.Lock()
        r := self.reading
        self.mu.Unlock()
        return r > self.threshold
    }

    pub fn Action(self: *SensorSource) {
        self.mu.Lock()
        r := self.reading
        self.mu.Unlock()
        print("DYNAMIC source triggered, reading: " + fmt.Ftoa(r))
    }

    pub fn Priority(self: *SensorSource) -> int {
        return 5
    }
}

// ClimateRules is a static ruleset that watches currentTemp.
ruleset ClimateRules {
    rule high_temp when currentTemp > 30.0 {
        action: {
            print("STATIC: high temperature alert: " + fmt.Ftoa(currentTemp))
        }
        priority: 1
    }

    rule low_temp when currentTemp < 10.0 {
        action: {
            print("STATIC: low temperature alert: " + fmt.Ftoa(currentTemp))
        }
        priority: 2
    }

    rule normal when currentTemp >= 10.0 && currentTemp <= 30.0 {
        action: {
            print("STATIC: normal temperature: " + fmt.Ftoa(currentTemp))
        }
        priority: 10
    }
}

fn main() {
    // Create a dynamic rule source that triggers when its reading is above 50.0.
    src := SensorSource.NewSensorSource(50.0)

    // Register the source with the ruleset. The static rules watch currentTemp,
    // and the dynamic source evaluates its own condition each loop.
    ClimateRules.registerRule(&src)

    // Start the ruleset background evaluation loop.
    ClimateRules.start()

    // High temperature triggers the static high_temp rule and the dynamic source.
    SetTemperature(35.0)
    src.SetReading(60.0)
    time.SleepMs(200)

    // Low temperature triggers the static low_temp rule.
    SetTemperature(5.0)
    src.SetReading(40.0)
    time.SleepMs(200)

    // Normal temperature triggers the static normal rule.
    SetTemperature(22.0)
    src.SetReading(30.0)
    time.SleepMs(200)

    // Stop the ruleset.
    ClimateRules.stop()
}
