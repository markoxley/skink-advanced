module daemon_test

import "daemon"
import "std/json"
import "std/reflect"
import "std/strconv"
import "std/testing"
import "std/web/router"
import "std/web/types"

fn setup(retention: int, threshold: int) -> router.Router {
    err := daemon.Init(":memory:", retention, threshold)
    testing.AssertEqualString("", err.message, "Init(:memory:)")
    return daemon.Router()
}

fn request(r: *router.Router, method: string, path: string, body: string) -> types.ResponseWriter {
    h := make(map[string]string)
    req := types.NewRequest(method, path, "", h, body)
    w := types.NewResponseWriter()
    r.ServeHTTP(req, w)
    return *w
}

// TestIngestAndAlertClassification verifies that ingested metrics below the
// threshold are stored as "ok" and metrics at or above the threshold are
// classified as "critical" and surfaced by GET /alerts.
pub fn TestIngestAndAlertClassification() {
    r := setup(10, 80)

    r1 := request(&r, "POST", "/ingest",
        `{"source":"auth","metric":"latency_ms","value":45}`)
    testing.AssertEqualInt(201, r1.Status(), "POST normal metric -> 201")
    testing.AssertContains(r1.ResponseBody(), `"status":"ok"`, "normal status is ok")

    r2 := request(&r, "POST", "/ingest",
        `{"source":"auth","metric":"latency_ms","value":95}`)
    testing.AssertEqualInt(201, r2.Status(), "POST critical metric -> 201")
    testing.AssertContains(r2.ResponseBody(), `"status":"critical"`, "high value is critical")

    alerts := request(&r, "GET", "/alerts", "")
    testing.AssertEqualInt(200, alerts.Status(), "GET /alerts -> 200")
    testing.AssertContains(alerts.ResponseBody(), `"value":95`, "alerts contains critical row")
}

// TestRetentionWindowPruning verifies that ingesting more than maxRetention
// samples evicts the oldest rows via the prefix slice view ids[0:dropCount].
pub fn TestRetentionWindowPruning() {
    r := setup(5, 90)
    i := 1
    for i <= 12 {
        body := `{"source":"db","metric":"qps","value":` + strconv.Itoa(i * 5) + `}`
        res := request(&r, "POST", "/ingest", body)
        testing.AssertEqualInt(201, res.Status(), "ingest status")
        i = i + 1
    }

    hres := request(&r, "GET", "/health", "")
    testing.AssertEqualInt(200, hres.Status(), "GET /health -> 200")
    var h daemon.HealthReport
    ht := reflect.TypeOf<daemon.HealthReport>(h)
    err := json.UnmarshalInto(hres.ResponseBody(), ht, int64(&h))
    testing.AssertEqualString("", err.message, "unmarshal health")
    testing.AssertEqualInt(5, h.samples, "retention capped at 5 samples")
    testing.AssertEqualInt(0, int(h.cycles), "0 reference cycles")
}

// TestSustainedLoadSoak drives 300+ request cycles (POST /ingest with
// retention eviction + GET /alerts + GET /health) and verifies zero RC
// reference cycles and bounded retention throughout.
pub fn TestSustainedLoadSoak() {
    r := setup(25, 85)
    baseCycles := testing.DetectCycles()

    i := 0
    for i < 300 {
        val := (i * 23) % 100
        body := `{"source":"worker","metric":"load","value":` + strconv.Itoa(val) + `}`
        res := request(&r, "POST", "/ingest", body)
        testing.AssertEqualInt(201, res.Status(), "soak ingest 201")
        if i % 15 == 0 {
            ares := request(&r, "GET", "/alerts", "")
            testing.AssertEqualInt(200, ares.Status(), "soak alerts 200")
        }
        i = i + 1
    }

    hres := request(&r, "GET", "/health", "")
    testing.AssertEqualInt(200, hres.Status(), "soak health 200")
    var h daemon.HealthReport
    ht := reflect.TypeOf<daemon.HealthReport>(h)
    err := json.UnmarshalInto(hres.ResponseBody(), ht, int64(&h))
    testing.AssertEqualString("", err.message, "unmarshal soak health")
    testing.AssertEqualInt(25, h.samples, "soak retention capped at 25")
    testing.AssertEqualInt(int(baseCycles), int(testing.DetectCycles()), "zero new RC cycles after soak")
}
