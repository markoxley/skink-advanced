module sensor_data

import "std/time"

pub struct SensorReading {
    deviceId: string
    sensorType: string
    value: float
    timestamp: int
    unit: string
}

pub struct Alert {
    ruleName: string
    message: string
    severity: string
    timestamp: int
    sensorData: SensorReading
}

pub fn NewSensorReading(deviceId: string, sensorType: string, value: float, unit: string) -> SensorReading {
    return SensorReading{
        deviceId: deviceId,
        sensorType: sensorType,
        value: value,
        timestamp: time.Timestamp(),
        unit: unit
    }
}
