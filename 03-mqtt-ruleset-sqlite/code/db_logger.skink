module db_logger

import "std/db"
import "std/str"
import "std/fmt"
import "std/time"

pub struct SensorReading {
    deviceId: string
    sensorType: string
    value: float
    timestamp: int
    unit: string
}

pub fn NewSensorReading(deviceId: string, sensorType: string, value: float, unit: string) -> SensorReading {
    return SensorReading{
        deviceId: deviceId,
        sensorType: sensorType,
        value: value,
        timestamp: time.Timestamp(),
        unit: unit
    }
}

pub struct Alert {
    ruleName: string
    message: string
    severity: string
    timestamp: int
    sensorData: SensorReading
}

pub struct DBLogger {
    conn: db.Connection

    pub fn NewDBLogger(dbPath: string) -> (DBLogger, error) {
        conn, err := db.Open("sqlite3", dbPath)
        if err.message != "" {
            return DBLogger{conn: db.Connection{driver: "", dsn: "", handle: 0}}, err
        }

        var res db.Result
        res, err = conn.Exec("CREATE TABLE IF NOT EXISTS sensor_readings (id INTEGER PRIMARY KEY AUTOINCREMENT, device_id TEXT NOT NULL, sensor_type TEXT NOT NULL, value REAL NOT NULL, unit TEXT NOT NULL, timestamp INTEGER NOT NULL)")
        if err.message != "" {
            return DBLogger{conn: db.Connection{driver: "", dsn: "", handle: 0}}, err
        }

        res, err = conn.Exec("CREATE TABLE IF NOT EXISTS alerts (id INTEGER PRIMARY KEY AUTOINCREMENT, rule_name TEXT NOT NULL, message TEXT NOT NULL, severity TEXT NOT NULL, timestamp INTEGER NOT NULL, sensor_id INTEGER)")
        if err.message != "" {
            return DBLogger{conn: db.Connection{driver: "", dsn: "", handle: 0}}, err
        }

        return DBLogger{conn: conn}, nil
    }

    pub fn LogReading(self: *DBLogger, reading: SensorReading) -> error {
        deviceId := str.Replace(reading.deviceId, "'", "''")
        sensorType := str.Replace(reading.sensorType, "'", "''")
        unit := str.Replace(reading.unit, "'", "''")

        b := str.NewBuilder(256)
        b.Write("INSERT INTO sensor_readings (device_id, sensor_type, value, unit, timestamp) VALUES ('")
        b.Write(deviceId)
        b.Write("','")
        b.Write(sensorType)
        b.Write("',")
        b.Write(fmt.Ftoa(reading.value))
        b.Write(",'")
        b.Write(unit)
        b.Write("',")
        b.Write(fmt.Itoa(reading.timestamp))
        b.Write(")")

        var res db.Result
        var err error
        res, err = self.conn.Exec(b.String())
        return err
    }

    pub fn LogAlert(self: *DBLogger, alert: Alert) -> error {
        ruleName := str.Replace(alert.ruleName, "'", "''")
        message := str.Replace(alert.message, "'", "''")
        severity := str.Replace(alert.severity, "'", "''")

        b := str.NewBuilder(256)
        b.Write("INSERT INTO alerts (rule_name, message, severity, timestamp, sensor_id) VALUES ('")
        b.Write(ruleName)
        b.Write("','")
        b.Write(message)
        b.Write("','")
        b.Write(severity)
        b.Write("',")
        b.Write(fmt.Itoa(alert.timestamp))
        b.Write(",0)")

        var res db.Result
        var err error
        res, err = self.conn.Exec(b.String())
        return err
    }

    pub fn GetRecentReadings(self: *DBLogger, limit: int) -> ([]SensorReading, error) {
        // String-to-number parsing helpers are not currently exposed by the standard
        // library, so this function returns an empty slice for now.
        return []SensorReading{}, nil
    }

    pub fn Close(self: *DBLogger) {
        self.conn.Close()
    }
}
