module mqtt_source

import "std/mqtt"
import "std/str"
import "std/sync"
import "std/errors"
import "db_logger"

// MQTTSource connects to an MQTT broker, subscribes to a topic and stores the
// most recent sensor reading. Receiving actual MQTT payloads currently requires
// libmosquitto message callbacks, which are not yet bound in std/mqtt, so this
// implementation keeps the subscription and connection lifecycle while exposing
// a way to inject readings for testing.
pub struct MQTTSource {
    client: mqtt.Client
    topic: string
    currentReading: db_logger.SensorReading
    logger: db_logger.DBLogger
    mu: *sync.Mutex
    stopped: bool
}

fn zeroSource() -> MQTTSource {
    var s MQTTSource
    s.mu = sync.NewMutex()
    return s
}

pub fn NewMQTTSource(host: string, port: int, topic: string, logger: db_logger.DBLogger) -> (MQTTSource, errors.Error) {
    client, err := mqtt.NewClient("skink_monitor", host, port)
    if err.message != "" {
        return zeroSource(), err
    }

    err = client.Connect()
    if err.message != "" {
        client.Close()
        return zeroSource(), err
    }

    var s MQTTSource
    s.client = client
    s.topic = topic
    s.logger = logger
    s.mu = sync.NewMutex()
    s.stopped = false
    return s, errors.New("")
}

pub fn Start(self: *MQTTSource) -> errors.Error {
    err := self.client.Subscribe(self.topic, 0)
    if err.message != "" {
        return err
    }

    // Without a message callback the client cannot receive payloads here.
    // The connection and subscription are set up so the lifecycle matches the
    // expected API.
    return errors.New("")
}

pub fn Stop(self: *MQTTSource) {
    self.stopped = true
    self.client.Disconnect()
    self.client.Close()
}

// HandlePayload parses a "device:sensor:value:unit" payload, stores it and
// logs it to the configured logger. The numeric value is not parsed because
// the standard library does not yet expose a string-to-float parser.
pub fn HandlePayload(self: *MQTTSource, payload: string) {
    parts := str.Split(payload, ":")
    if len(parts) >= 4 {
        reading := db_logger.NewSensorReading(parts[0], parts[1], 0.0, parts[3])
        self.StoreReading(reading)
    }
}

pub fn StoreReading(self: *MQTTSource, reading: db_logger.SensorReading) {
    self.mu.Lock()
    self.currentReading = reading
    self.mu.Unlock()
    self.logger.LogReading(reading)
}

pub fn GetReading(self: *MQTTSource) -> db_logger.SensorReading {
    self.mu.Lock()
    r := self.currentReading
    self.mu.Unlock()
    return r
}

// RuleSource template implementation.
pub fn name(self: *MQTTSource) -> string {
    return "mqtt_sensor_source"
}

pub fn start(self: *MQTTSource) {
    self.Start()
}

pub fn stop(self: *MQTTSource) {
    self.Stop()
}

pub fn triggered(self: *MQTTSource) -> bool {
    return true
}

pub fn Action(self: *MQTTSource) {
    // Real MQTT reception is not yet available; this is a placeholder for the
    // rule source action hook.
}

pub fn Priority(self: *MQTTSource) -> int {
    return 10
}
