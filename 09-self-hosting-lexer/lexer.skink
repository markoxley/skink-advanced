// A Skink lexer written in Skink.
//
// This is a proof-of-concept for self-hosting: it tokenizes Skink source
// code using the same language features that a self-hosted compiler would
// need (tagged unions, pattern matching, string manipulation, structs
// with methods, error handling).
//
// The lexer is a straightforward port of the Go lexer in compiler/lexer/.
// It supports identifiers, keywords, numeric literals (decimal, hex, binary,
// octal), string literals, comments (line, block, doc), and all Skink
// operators and punctuation.
module lexer

import "std/str"
import "std/libc"

// === Token Kinds ===
//
// Token kinds are integer constants. The Go version uses string-typed
// constants, but int is more efficient and equally clear.

    // Literals and special
pub const T_ILLEGAL = 0
pub const T_EOF = 1
pub const T_NEWLINE = 2
pub const T_IDENT = 3
pub const T_INT = 4
pub const T_FLOAT = 5
pub const T_STRING = 6
pub const T_BYTES = 7
pub const T_COMMENT = 8
pub const T_DOC = 9

    // Operators and punctuation
pub const T_ASSIGN = 10
pub const T_COLON = 11
pub const T_COLONASS = 12
pub const T_COMMA = 13
pub const T_SEMICOLON = 14
pub const T_DOT = 15
pub const T_DOTDOT = 16
pub const T_ELLIPSIS = 17
pub const T_ARROW = 18
pub const T_LPAREN = 19
pub const T_RPAREN = 20
pub const T_LBRACE = 21
pub const T_RBRACE = 22
pub const T_LBRACKET = 23
pub const T_RBRACKET = 24
pub const T_LT = 25
pub const T_GT = 26
pub const T_LE = 27
pub const T_SEND = 28
pub const T_GE = 29
pub const T_EQ = 30
pub const T_NE = 31
pub const T_PLUS = 32
pub const T_MINUS = 33
pub const T_SLASH = 34
pub const T_STAR = 35
pub const T_PERCENT = 36
pub const T_AMPERSAND = 37
pub const T_PIPE = 38
pub const T_CARET = 39
pub const T_TILDE = 40
pub const T_BANG = 41
pub const T_AND = 42
pub const T_OR = 43
pub const T_AT = 44
pub const T_QUESTION = 45
pub const T_DBLSTAR = 46
pub const T_LSHIFT = 47
pub const T_RSHIFT = 48
pub const T_PLUSEQ = 49
pub const T_MINUSEQ = 50
pub const T_STAREQ = 51
pub const T_SLASHEQ = 52
pub const T_PERCEQ = 53
pub const T_AMPEQ = 54
pub const T_PIPEEQ = 55
pub const T_CARETEQ = 56
pub const T_LSHIFTEQ = 57
pub const T_RSHIFTEQ = 58
pub const T_FATARROW = 59

    // Keywords
pub const T_FN = 100
pub const T_PUB = 101
pub const T_CONST = 102
pub const T_VAR = 103
pub const T_TYPE = 104
pub const T_STRUCT = 105
pub const T_ENUM = 106
pub const T_SERVICE = 107
pub const T_RULESET = 108
pub const T_IMPL = 109
pub const T_RULE = 110
pub const T_WHEN = 111
pub const T_ACTION = 112
pub const T_PRIORITY = 113
pub const T_IF = 114
pub const T_ELSE = 115
pub const T_MATCH = 116
pub const T_FOR = 117
pub const T_IN = 118
pub const T_RANGE = 119
pub const T_WHILE = 120
pub const T_UNTIL = 121
pub const T_BREAK = 122
pub const T_CONTINUE = 123
pub const T_RETURN = 124
pub const T_DEFER = 125
pub const T_UNSAFE = 126
pub const T_WITH = 127
pub const T_ASYNC = 128
pub const T_AWAIT = 129
pub const T_SPAWN = 130
pub const T_SELECT = 131
pub const T_SWITCH = 132
pub const T_TEMPLATE = 133
pub const T_CASE = 134
pub const T_DEFAULT = 135
pub const T_COMPTIME = 136
pub const T_EXTERN = 137
pub const T_MODULE = 138
pub const T_IMPORT = 139
pub const T_AS = 140
pub const T_TRUE = 141
pub const T_FALSE = 142
pub const T_NIL = 143
pub const T_ERROR = 144
pub const T_IOTA = 145
pub const T_SIZEOF = 146
pub const T_ALIGNOF = 147
pub const T_MAP = 148
pub const T_CHAN = 149
pub const T_SET = 150
pub const T_TENSOR = 151
pub const T_VOID = 152
pub const T_FROM = 153
pub const T_WHERE = 154
pub const T_ORDERBY = 155
pub const T_ASCENDING = 156
pub const T_DESCENDING = 157
pub const T_GROUP = 158
pub const T_BY = 159
pub const T_JOIN = 160
pub const T_INTO = 161

    // Type keywords
pub const T_INT8 = 170
pub const T_INT16 = 171
pub const T_INT32 = 172
pub const T_INT64 = 173
pub const T_UINT = 174
pub const T_UINT8 = 175
pub const T_UINT16 = 176
pub const T_UINT32 = 177
pub const T_UINT64 = 178
pub const T_BOOL = 179
pub const T_STRING_TYPE = 180
pub const T_BYTES_TYPE = 181

// Token represents a single lexical unit.
struct Token {
    kind: int       // token kind (T_* constant)
    literal: string // raw text from source
    line: int       // 1-based line number
    col: int        // 1-based column number
}

// KindName returns a human-readable name for a token kind.
// Useful for debugging and error messages.
pub fn KindName(kind: int) -> string {
    match kind {
        T_ILLEGAL => "ILLEGAL"
        T_EOF     => "EOF"
        T_NEWLINE => "NEWLINE"
        T_IDENT   => "IDENT"
        T_INT     => "INT"
        T_FLOAT   => "FLOAT"
        T_STRING  => "STRING"
        T_COMMENT => "COMMENT"
        T_DOC     => "DOC"
        T_ASSIGN  => "="
        T_EQ      => "=="
        T_FATARROW => "=>"
        T_COLON   => ":"
        T_COLONASS => ":="
        T_COMMA   => ","
        T_SEMICOLON => ";"
        T_DOT     => "."
        T_DOTDOT  => ".."
        T_ELLIPSIS => "..."
        T_ARROW   => "->"
        T_LPAREN  => "("
        T_RPAREN  => ")"
        T_LBRACE  => "{"
        T_RBRACE  => "}"
        T_LBRACKET => "["
        T_RBRACKET => "]"
        T_LT      => "<"
        T_GT      => ">"
        T_LE      => "<="
        T_SEND    => "<-"
        T_GE      => ">="
        T_NE      => "!="
        T_PLUS    => "+"
        T_MINUS   => "-"
        T_SLASH   => "/"
        T_STAR    => "*"
        T_PERCENT => "%"
        T_AMPERSAND => "&"
        T_PIPE    => "|"
        T_CARET   => "^"
        T_TILDE   => "~"
        T_BANG    => "!"
        T_AND     => "&&"
        T_OR      => "||"
        T_AT      => "@"
        T_QUESTION => "?"
        T_DBLSTAR => "**"
        T_LSHIFT  => "<<"
        T_RSHIFT  => ">>"
        T_PLUSEQ  => "+="
        T_MINUSEQ => "-="
        T_STAREQ  => "*="
        T_SLASHEQ => "/="
        T_PERCEQ  => "%="
        T_AMPEQ   => "&="
        T_PIPEEQ  => "|="
        T_CARETEQ => "^="
        T_LSHIFTEQ => "<<="
        T_RSHIFTEQ => ">>="
        T_FN      => "fn"
        T_PUB     => "pub"
        T_CONST   => "const"
        T_VAR     => "var"
        T_STRUCT  => "struct"
        T_ENUM    => "enum"
        T_IF      => "if"
        T_ELSE    => "else"
        T_MATCH   => "match"
        T_FOR     => "for"
        T_WHILE   => "while"
        T_RETURN  => "return"
        T_BREAK   => "break"
        T_CONTINUE => "continue"
        T_IMPORT  => "import"
        T_MODULE  => "module"
        T_TRUE    => "true"
        T_FALSE   => "false"
        T_NIL     => "nil"
        T_SPAWN   => "spawn"
        T_DEFER   => "defer"
        T_EXTERN  => "extern"
        T_TEMPLATE => "template"
        T_TYPE    => "type"
        T_MAP     => "map"
        T_CHAN    => "chan"
        T_SET     => "set"
        T_VOID    => "void"
        T_ERROR   => "error"
        _         => "TOK"
    }
}

// keywordKind returns the token kind for a keyword string, or T_IDENT if not a keyword.
// Uses a series of string comparisons instead of a hash map because global
// map initialization with make() is not yet supported by the codegen.
fn lookupKeyword(ident: string) -> int {
    // Check common keywords first with single-char comparisons.
    n := str.Len(ident)
    if n == 0 {
        return T_IDENT
    }
    if n == 2 {
        c0 := ident[0]
        c1 := ident[1]
        if c0 == 102 && c1 == 110 { return T_FN }             // "fn"
        if c0 == 105 && c1 == 102 { return T_IF }             // "if"
        if c0 == 105 && c1 == 110 { return T_IN }             // "in"
        if c0 == 97 && c1 == 115 { return T_AS }              // "as"
        if c0 == 98 && c1 == 121 { return T_BY }              // "by"
    }
    if n == 3 {
        c0 := ident[0]
        if c0 == 102 { if ident == "for" { return T_FOR } }   // "for"
        if c0 == 118 { if ident == "var" { return T_VAR } }   // "var"
        if c0 == 112 { if ident == "pub" { return T_PUB } }   // "pub"
        if c0 == 115 { if ident == "set" { return T_SET } }   // "set"
        if c0 == 109 { if ident == "map" { return T_MAP } }   // "map"
    }
    if n == 4 {
        c0 := ident[0]
        if c0 == 101 { if ident == "else" { return T_ELSE } if ident == "enum" { return T_ENUM } if ident == "error" { return T_ERROR } }
        if c0 == 116 { if ident == "type" { return T_TYPE } if ident == "true" { return T_TRUE } }
        if c0 == 118 { if ident == "void" { return T_VOID } }
        if c0 == 105 { if ident == "iota" { return T_IOTA } if ident == "int8" { return T_INT8 } }
        if c0 == 98 { if ident == "bool" { return T_BOOL } if ident == "byte" { return T_UINT8 } }
        if c0 == 99 { if ident == "case" { return T_CASE } if ident == "chan" { return T_CHAN } }
        if c0 == 117 { if ident == "uint" { return T_UINT } }
        if c0 == 106 { if ident == "join" { return T_JOIN } }
        if c0 == 114 { if ident == "rule" { return T_RULE } }
        if c0 == 119 { if ident == "when" { return T_WHEN } }
    }
    if n == 5 {
        c0 := ident[0]
        if c0 == 99 { if ident == "const" { return T_CONST } if ident == "comptime" { return T_COMPTIME } }
        if c0 == 98 { if ident == "break" { return T_BREAK } }
        if c0 == 117 { if ident == "until" { return T_UNTIL } if ident == "uint8" { return T_UINT8 } }
        if c0 == 105 { if ident == "int16" { return T_INT16 } if ident == "int32" { return T_INT32 } if ident == "int64" { return T_INT64 } }
        if c0 == 102 { if ident == "float" { return T_FLOAT } }
        if c0 == 97 { if ident == "async" { return T_ASYNC } if ident == "await" { return T_AWAIT } }
        if c0 == 115 { if ident == "spawn" { return T_SPAWN } }
        if c0 == 109 { if ident == "match" { return T_MATCH } }
        if c0 == 114 { if ident == "range" { return T_RANGE } }
        if c0 == 119 { if ident == "where" { return T_WHERE } }
        if c0 == 105 { if ident == "into" { return T_INTO } }
        if c0 == 110 { if ident == "nil" { return T_NIL } }
    }
    if n == 6 {
        c0 := ident[0]
        if c0 == 115 { if ident == "struct" { return T_STRUCT } if ident == "switch" { return T_SELECT } }
        if c0 == 114 { if ident == "return" { return T_RETURN } }
        if c0 == 105 { if ident == "import" { return T_IMPORT } if ident == "int128" { return T_INT } }
        if c0 == 101 { if ident == "extern" { return T_EXTERN } }
        if c0 == 109 { if ident == "module" { return T_MODULE } }
        if c0 == 117 { if ident == "uint16" { return T_UINT16 } if ident == "uint32" { return T_UINT32 } if ident == "uint64" { return T_UINT64 } }
        if c0 == 119 { if ident == "while" { return T_WHILE } }
        if c0 == 100 { if ident == "defer" { return T_DEFER } }
        if c0 == 97 { if ident == "action" { return T_ACTION } }
        if c0 == 102 { if ident == "false" { return T_FALSE } }
        if c0 == 112 { if ident == "pub" { return T_PUB } }
        if c0 == 116 { if ident == "tensor" { return T_TENSOR } }
        if c0 == 103 { if ident == "group" { return T_GROUP } }
    }
    if n == 7 {
        c0 := ident[0]
        if c0 == 112 { if ident == "pub" { return T_PUB } }
        if c0 == 100 { if ident == "default" { return T_DEFAULT } }
        if c0 == 117 { if ident == "unsafe" { return T_UNSAFE } }
        if c0 == 115 { if ident == "service" { return T_SERVICE } }
        if c0 == 105 { if ident == "impl" { return T_IMPL } }
        if c0 == 99 { if ident == "comptime" { return T_COMPTIME } }
        if c0 == 114 { if ident == "ruleset" { return T_RULESET } }
        if c0 == 111 { if ident == "orderby" { return T_ORDERBY } }
        if c0 == 97 { if ident == "alignof" { return T_ALIGNOF } }
        if c0 == 115 { if ident == "sizeof" { return T_SIZEOF } }
    }
    if n == 8 {
        c0 := ident[0]
        if c0 == 99 { if ident == "continue" { return T_CONTINUE } }
        if c0 == 112 { if ident == "priority" { return T_PRIORITY } }
        if c0 == 116 { if ident == "template" { return T_TEMPLATE } }
        if c0 == 101 { if ident == "extern" { return T_EXTERN } }
        if c0 == 97 { if ident == "ascending" { return T_ASCENDING } }
        if c0 == 115 { if ident == "string" { return T_STRING_TYPE } }
        if c0 == 98 { if ident == "bytes" { return T_BYTES_TYPE } }
    }
    if n == 9 {
        c0 := ident[0]
        if c0 == 99 { if ident == "comptime" { return T_COMPTIME } }
        if c0 == 100 { if ident == "descending" { return T_DESCENDING } }
        if c0 == 115 { if ident == "sizeof" { return T_SIZEOF } }
        if c0 == 97 { if ident == "alignof" { return T_ALIGNOF } }
    }
    if n == 10 {
        c0 := ident[0]
        if c0 == 99 { if ident == "comptime" { return T_COMPTIME } }
    }
    return T_IDENT
}

// === Lexer ===

// Lexer turns a source string into a stream of tokens.
struct Lexer {
    input: string    // full source text
    pos: int         // byte index of current char
    readPos: int     // byte index after current char
    ch: int          // current char (byte value, 0 = EOF)
    line: int        // current line (1-based)
    col: int         // current column (1-based)
}

// New creates a Lexer for the given input string.
pub fn New(input: string) -> *Lexer {
    l := Lexer{input: input, pos: 0, readPos: 0, ch: 0, line: 1, col: 0}
    l.readChar()
    return &l
}

// readChar advances to the next byte in the input.
fn readChar(self: *Lexer) {
    self.pos = self.readPos
    if self.readPos >= str.Len(self.input) {
        self.ch = 0
    } else {
        self.ch = self.input[self.readPos]
        self.readPos = self.readPos + 1
    }
    if self.ch == 10 { // '\n'
        self.line = self.line + 1
        self.col = 0
    } else {
        self.col = self.col + 1
    }
}

// peekChar returns the next byte without advancing.
fn peekChar(self: *Lexer) -> int {
    if self.readPos >= str.Len(self.input) {
        return 0
    }
    return self.input[self.readPos]
}

// skipWhitespace advances past spaces, tabs, and carriage returns.
fn skipWhitespace(self: *Lexer) {
    for self.ch == 32 || self.ch == 9 || self.ch == 13 { // ' ', '\t', '\r'
        self.readChar()
    }
}

// isLetter returns true if ch can start or continue an identifier.
fn isLetter(ch: int) -> bool {
    return (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95 // A-Z, a-z, _
}

// isDigit returns true if ch is a decimal digit.
fn isDigit(ch: int) -> bool {
    return ch >= 48 && ch <= 57 // 0-9
}

// isHexDigit returns true if ch is a hexadecimal digit.
fn isHexDigit(ch: int) -> bool {
    return (ch >= 48 && ch <= 57) || (ch >= 97 && ch <= 102) || (ch >= 65 && ch <= 70)
}

// isAlphaNum returns true if ch is a letter, digit, or underscore.
fn isAlphaNum(ch: int) -> bool {
    return isLetter(ch) || isDigit(ch)
}

// NextToken returns the next token from the input stream.
pub fn NextToken(self: *Lexer) -> Token {
    self.skipWhitespace()

    line := self.line
    col := self.col
    ch := self.ch

    match ch {
        10 => { // '\n' newline
            self.readChar()
            return Token{kind: T_NEWLINE, literal: "\\n", line: line, col: col}
        }
        61 => { // '='
            if self.peekChar() == 61 { // '=='
                self.readChar()
                self.readChar()
                return Token{kind: T_EQ, literal: "==", line: line, col: col}
            }
            if self.peekChar() == 62 { // '=>'
                self.readChar()
                self.readChar()
                return Token{kind: T_FATARROW, literal: "=>", line: line, col: col}
            }
            self.readChar()
            return Token{kind: T_ASSIGN, literal: "=", line: line, col: col}
        }
        58 => { // ':'
            if self.peekChar() == 61 { // ':='
                self.readChar()
                self.readChar()
                return Token{kind: T_COLONASS, literal: ":=", line: line, col: col}
            }
            self.readChar()
            return Token{kind: T_COLON, literal: ":", line: line, col: col}
        }
        43 => { // '+'
            if self.peekChar() == 61 { // '+='
                self.readChar()
                self.readChar()
                return Token{kind: T_PLUSEQ, literal: "+=", line: line, col: col}
            }
            self.readChar()
            return Token{kind: T_PLUS, literal: "+", line: line, col: col}
        }
        45 => { // '-'
            if self.peekChar() == 62 { // '->'
                self.readChar()
                self.readChar()
                return Token{kind: T_ARROW, literal: "->", line: line, col: col}
            }
            if self.peekChar() == 61 { // '-='
                self.readChar()
                self.readChar()
                return Token{kind: T_MINUSEQ, literal: "-=", line: line, col: col}
            }
            self.readChar()
            return Token{kind: T_MINUS, literal: "-", line: line, col: col}
        }
        42 => { // '*'
            if self.peekChar() == 42 { // '**'
                self.readChar()
                self.readChar()
                return Token{kind: T_DBLSTAR, literal: "**", line: line, col: col}
            }
            if self.peekChar() == 61 { // '*='
                self.readChar()
                self.readChar()
                return Token{kind: T_STAREQ, literal: "*=", line: line, col: col}
            }
            self.readChar()
            return Token{kind: T_STAR, literal: "*", line: line, col: col}
        }
        47 => { // '/'
            if self.peekChar() == 47 { // '//'
                return self.readLineComment(line, col)
            }
            if self.peekChar() == 42 { // '/*'
                return self.readBlockComment(line, col)
            }
            if self.peekChar() == 61 { // '/='
                self.readChar()
                self.readChar()
                return Token{kind: T_SLASHEQ, literal: "/=", line: line, col: col}
            }
            self.readChar()
            return Token{kind: T_SLASH, literal: "/", line: line, col: col}
        }
        37 => { // '%'
            if self.peekChar() == 61 { // '%='
                self.readChar()
                self.readChar()
                return Token{kind: T_PERCEQ, literal: "%=", line: line, col: col}
            }
            self.readChar()
            return Token{kind: T_PERCENT, literal: "%", line: line, col: col}
        }
        60 => { // '<'
            if self.peekChar() == 61 { // '<='
                self.readChar()
                self.readChar()
                return Token{kind: T_LE, literal: "<=", line: line, col: col}
            }
            if self.peekChar() == 45 { // '<-'
                self.readChar()
                self.readChar()
                return Token{kind: T_SEND, literal: "<-", line: line, col: col}
            }
            if self.peekChar() == 60 { // '<<'
                self.readChar()
                if self.peekChar() == 61 { // '<<='
                    self.readChar()
                    self.readChar()
                    return Token{kind: T_LSHIFTEQ, literal: "<<=", line: line, col: col}
                }
                self.readChar()
                return Token{kind: T_LSHIFT, literal: "<<", line: line, col: col}
            }
            self.readChar()
            return Token{kind: T_LT, literal: "<", line: line, col: col}
        }
        62 => { // '>'
            if self.peekChar() == 61 { // '>='
                self.readChar()
                self.readChar()
                return Token{kind: T_GE, literal: ">=", line: line, col: col}
            }
            if self.peekChar() == 62 { // '>>'
                self.readChar()
                if self.peekChar() == 61 { // '>>='
                    self.readChar()
                    self.readChar()
                    return Token{kind: T_RSHIFTEQ, literal: ">>=", line: line, col: col}
                }
                self.readChar()
                return Token{kind: T_RSHIFT, literal: ">>", line: line, col: col}
            }
            self.readChar()
            return Token{kind: T_GT, literal: ">", line: line, col: col}
        }
        38 => { // '&'
            if self.peekChar() == 38 { // '&&'
                self.readChar()
                self.readChar()
                return Token{kind: T_AND, literal: "&&", line: line, col: col}
            }
            if self.peekChar() == 61 { // '&='
                self.readChar()
                self.readChar()
                return Token{kind: T_AMPEQ, literal: "&=", line: line, col: col}
            }
            self.readChar()
            return Token{kind: T_AMPERSAND, literal: "&", line: line, col: col}
        }
        124 => { // '|'
            if self.peekChar() == 124 { // '||'
                self.readChar()
                self.readChar()
                return Token{kind: T_OR, literal: "||", line: line, col: col}
            }
            if self.peekChar() == 61 { // '|='
                self.readChar()
                self.readChar()
                return Token{kind: T_PIPEEQ, literal: "|=", line: line, col: col}
            }
            self.readChar()
            return Token{kind: T_PIPE, literal: "|", line: line, col: col}
        }
        94 => { // '^'
            if self.peekChar() == 61 { // '^='
                self.readChar()
                self.readChar()
                return Token{kind: T_CARETEQ, literal: "^=", line: line, col: col}
            }
            self.readChar()
            return Token{kind: T_CARET, literal: "^", line: line, col: col}
        }
        126 => { // '~'
            self.readChar()
            return Token{kind: T_TILDE, literal: "~", line: line, col: col}
        }
        33 => { // '!'
            if self.peekChar() == 61 { // '!='
                self.readChar()
                self.readChar()
                return Token{kind: T_NE, literal: "!=", line: line, col: col}
            }
            self.readChar()
            return Token{kind: T_BANG, literal: "!", line: line, col: col}
        }
        64 => { // '@'
            self.readChar()
            return Token{kind: T_AT, literal: "@", line: line, col: col}
        }
        63 => { // '?'
            self.readChar()
            return Token{kind: T_QUESTION, literal: "?", line: line, col: col}
        }
        40 => { // '('
            self.readChar()
            return Token{kind: T_LPAREN, literal: "(", line: line, col: col}
        }
        41 => { // ')'
            self.readChar()
            return Token{kind: T_RPAREN, literal: ")", line: line, col: col}
        }
        123 => { // '{'
            self.readChar()
            return Token{kind: T_LBRACE, literal: "{", line: line, col: col}
        }
        125 => { // '}'
            self.readChar()
            return Token{kind: T_RBRACE, literal: "}", line: line, col: col}
        }
        91 => { // '['
            self.readChar()
            return Token{kind: T_LBRACKET, literal: "[", line: line, col: col}
        }
        93 => { // ']'
            self.readChar()
            return Token{kind: T_RBRACKET, literal: "]", line: line, col: col}
        }
        44 => { // ','
            self.readChar()
            return Token{kind: T_COMMA, literal: ",", line: line, col: col}
        }
        46 => { // '.'
            if self.peekChar() == 46 { // '..'
                self.readChar()
                if self.peekChar() == 46 { // '...'
                    self.readChar()
                    self.readChar()
                    return Token{kind: T_ELLIPSIS, literal: "...", line: line, col: col}
                }
                self.readChar()
                return Token{kind: T_DOTDOT, literal: "..", line: line, col: col}
            }
            self.readChar()
            return Token{kind: T_DOT, literal: ".", line: line, col: col}
        }
        59 => { // ';'
            self.readChar()
            return Token{kind: T_SEMICOLON, literal: ";", line: line, col: col}
        }
        34 => { // '"' double-quote string
            return self.readString(34, line, col)
        }
        96 => { // '`' backtick string
            return self.readString(96, line, col)
        }
        0 => { // EOF
            return Token{kind: T_EOF, literal: "", line: line, col: col}
        }
        _ => {
            if isDigit(ch) {
                return self.readNumber(line, col)
            }
            if isLetter(ch) {
                return self.readIdentifier(line, col)
            }
            // Illegal character
            self.readChar()
            return Token{kind: T_ILLEGAL, literal: str.Substr(self.input, self.pos - 1, 1), line: line, col: col}
        }
    }
}

// readIdentifier consumes an identifier or keyword.
fn readIdentifier(self: *Lexer, line: int, col: int) -> Token {
    start := self.pos
    for isAlphaNum(self.ch) {
        self.readChar()
    }
    literal := str.Substr(self.input, start, self.pos - start)
    kind := lookupKeyword(literal)
    return Token{kind: kind, literal: literal, line: line, col: col}
}

// readNumber consumes a numeric literal (integer or float).
fn readNumber(self: *Lexer, line: int, col: int) -> Token {
    start := self.pos
    isFloatVal := false

    // Handle hex (0x), binary (0b), octal (0o) prefixes
    if self.ch == 48 { // '0'
        next := self.peekChar()
        if next == 120 || next == 88 || next == 98 || next == 66 || next == 111 || next == 79 {
            // 'x'/'X'/'b'/'B'/'o'/'O'
            self.readChar() // consume '0'
            self.readChar() // consume prefix char
            for isHexDigit(self.ch) || self.ch == 95 { // '_'
                self.readChar()
            }
            literal := str.Substr(self.input, start, self.pos - start)
            return Token{kind: T_INT, literal: literal, line: line, col: col}
        }
    }

    for isDigit(self.ch) || self.ch == 46 || self.ch == 101 || self.ch == 69 || self.ch == 43 || self.ch == 45 || self.ch == 95 {
        // '.', 'e', 'E', '+', '-', '_'
        if self.ch == 46 { // '.'
            if isFloatVal {
                break
            }
            if self.peekChar() == 46 { // '..' — don't consume
                break
            }
            isFloatVal = true
        }
        self.readChar()
    }
    literal := str.Substr(self.input, start, self.pos - start)
    kind := T_INT
    if isFloatVal {
        kind = T_FLOAT
    }
    return Token{kind: kind, literal: literal, line: line, col: col}
}

// readString consumes a string literal up to the closing quote.
fn readString(self: *Lexer, quote: int, line: int, col: int) -> Token {
    self.readChar() // consume opening quote
    start := self.pos
    for self.ch != quote && self.ch != 0 {
        if self.ch == 92 { // '\' escape
            self.readChar()
            if self.ch == 0 {
                break
            }
        }
        self.readChar()
    }
    literal := str.Substr(self.input, start, self.pos - start)
    if self.ch == quote {
        self.readChar() // consume closing quote
    }
    return Token{kind: T_STRING, literal: literal, line: line, col: col}
}

// readLineComment consumes a // comment.
fn readLineComment(self: *Lexer, line: int, col: int) -> Token {
    start := self.pos
    for self.ch != 10 && self.ch != 0 { // '\n' or EOF
        self.readChar()
    }
    literal := str.Substr(self.input, start, self.pos - start)
    kind := T_COMMENT
    // Check for doc comment (///)
    if str.Len(literal) > 2 {
        if literal[2] == 47 { // '/'
            kind = T_DOC
        }
    }
    return Token{kind: kind, literal: literal, line: line, col: col}
}

// readBlockComment consumes a /* */ comment.
fn readBlockComment(self: *Lexer, line: int, col: int) -> Token {
    start := self.pos
    self.readChar() // consume '/'
    self.readChar() // consume '*'
    for {
        if self.ch == 42 && self.peekChar() == 47 { // '*' followed by '/'
            self.readChar()
            self.readChar()
            break
        }
        if self.ch == 0 {
            break
        }
        self.readChar()
    }
    literal := str.Substr(self.input, start, self.pos - start)
    return Token{kind: T_COMMENT, literal: literal, line: line, col: col}
}

// Tokenize lexes the entire input and returns a slice of all tokens
// (including newlines and comments), ending with an EOF token.
pub fn Tokenize(input: string) -> []Token {
    l := New(input)
    var tokens []Token
    for {
        tok := l.NextToken()
        tokens = append(tokens, tok)
        if tok.kind == T_EOF {
            break
        }
    }
    return tokens
}
