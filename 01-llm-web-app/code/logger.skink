module logger

import "std/fs"
import "std/str"
import "std/errors"

pub struct Logger {
    path: string
}

pub fn NewLogger(path: string) -> (Logger, Error) {
    // Ensure file exists by writing empty content
    writeErr := fs.WriteAll(path, "")
    if writeErr.message != "" {
        return Logger{path: ""}, writeErr
    }
    return Logger{path: path}, New("")
}

pub fn Log(l: Logger, message: string) {
    if l.path == "" {
        return
    }
    
    existing, _ := fs.ReadAll(l.path)
    updated := str.Concat(existing, str.Concat(message, "\n"))
    fs.WriteAll(l.path, updated)
}

pub fn Close(l: Logger) {
    // Nothing to close for path-based logger
}
