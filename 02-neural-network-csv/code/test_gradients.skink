module main

import "std/tensor"

struct NN {
    layer1: LinearLayer
    layer2: LinearLayer
    layer3: LinearLayer
    lr: float
}

fn NewNN() -> NN {
    return NN{
        layer1: NewLinear(4, 16),
        layer2: NewLinear(16, 8),
        layer3: NewLinear(8, 3),
        lr: 0.01
    }
}

fn reluDeriv(t: Tensor) -> Tensor {
    result := Zeros(t.shape)
    i := 0
    for i < len(t.data) {
        if t.data[i] > 0.0 {
            result.data[i] = 1.0
        }
        i = i + 1
    }
    return result
}

fn sumRows(t: Tensor) -> Tensor {
    rows := t.Shape()[0]
    cols := t.Shape()[1]
    result := Zeros([1, cols])
    j := 0
    for j < cols {
        s := 0.0
        i := 0
        for i < rows {
            s = s + t.Get([i, j])
            i = i + 1
        }
        result.Set([0, j], s)
        j = j + 1
    }
    return result
}

fn ComputeGradients(nn: NN, x: Tensor, y: Tensor) -> (Tensor, Tensor, Tensor, Tensor, Tensor, Tensor) {
    z1 := Add(MatMul(x, nn.layer1.weights), nn.layer1.bias)
    a1 := ReLU(z1)
    z2 := Add(MatMul(a1, nn.layer2.weights), nn.layer2.bias)
    a2 := ReLU(z2)
    z3 := Add(MatMul(a2, nn.layer3.weights), nn.layer3.bias)
    a3 := Softmax(z3)
    
    temp := Sub(a3, y)
    dw3 := MatMul(Transpose(a2), temp)
    db3 := sumRows(temp)
    temp = MatMul(temp, Transpose(nn.layer3.weights))
    temp = Mul(temp, reluDeriv(z2))
    dw2 := MatMul(Transpose(a1), temp)
    db2 := sumRows(temp)
    temp = MatMul(temp, Transpose(nn.layer2.weights))
    temp = Mul(temp, reluDeriv(z1))
    dw1 := MatMul(Transpose(x), temp)
    db1 := sumRows(temp)
    
    return dw1, db1, dw2, db2, dw3, db3
}

fn main() -> int {
    print("Creating NN...")
    nn := NewNN()
    
    x := Zeros([15, 4])
    y := Zeros([15, 3])
    
    print("Computing gradients...")
    dw1, db1, dw2, db2, dw3, db3 := ComputeGradients(nn, x, y)
    n1 := len(dw1.data)
    n2 := len(db1.data)
    n3 := len(dw2.data)
    n4 := len(db2.data)
    n5 := len(dw3.data)
    n6 := len(db3.data)
    total := n1 + n2 + n3 + n4 + n5 + n6
    print("Total gradient elements: {total}")
    print("Done!")
    return 0
}
