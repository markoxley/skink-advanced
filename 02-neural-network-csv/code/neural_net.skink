module neural_net

import "std/tensor"

pub struct NeuralNetwork {
    layer1: LinearLayer
    layer2: LinearLayer
    layer3: LinearLayer
    learningRate: float
}

pub fn NewNeuralNetwork(inputSize: int, hidden1: int, hidden2: int, outputSize: int, learningRate: float) -> NeuralNetwork {
    return NeuralNetwork{
        layer1: tensor.NewLinear(inputSize, hidden1),
        layer2: tensor.NewLinear(hidden1, hidden2),
        layer3: tensor.NewLinear(hidden2, outputSize),
        learningRate: learningRate
    }
}

pub fn Forward(nn: NeuralNetwork, x: Tensor) -> Tensor {
    h1 := nn.layer1.Forward(x)
    h1 = tensor.ReLU(h1)
    
    h2 := nn.layer2.Forward(h1)
    h2 = tensor.ReLU(h2)
    
    logits := nn.layer3.Forward(h2)
    output := tensor.Softmax(logits)
    
    return output
}

fn reluDeriv(t: Tensor) -> Tensor {
    result := tensor.Zeros(t.shape)
    i := 0
    for i < len(t.data) {
        if t.data[i] > 0.0 {
            result.data[i] = 1.0
        }
        i = i + 1
    }
    return result
}

fn sumRows(t: Tensor) -> Tensor {
    rows := t.Shape()[0]
    cols := t.Shape()[1]
    result := tensor.Zeros([]int{1, cols})
    j := 0
    for j < cols {
        s := 0.0
        i := 0
        for i < rows {
            s = s + t.data[i * cols + j]
            i = i + 1
        }
        result.data[j] = s
        j = j + 1
    }
    return result
}

fn ApplyGradients(nn: *NeuralNetwork, dw1: Tensor, db1: Tensor, dw2: Tensor, db2: Tensor, dw3: Tensor, db3: Tensor) {
    lr := nn.learningRate
    i := 0
    for i < len(nn.layer3.weights.data) {
        nn.layer3.weights.data[i] = nn.layer3.weights.data[i] - dw3.data[i] * lr
        i = i + 1
    }
    i = 0
    for i < len(nn.layer3.bias.data) {
        nn.layer3.bias.data[i] = nn.layer3.bias.data[i] - db3.data[i] * lr
        i = i + 1
    }
    i = 0
    for i < len(nn.layer2.weights.data) {
        nn.layer2.weights.data[i] = nn.layer2.weights.data[i] - dw2.data[i] * lr
        i = i + 1
    }
    i = 0
    for i < len(nn.layer2.bias.data) {
        nn.layer2.bias.data[i] = nn.layer2.bias.data[i] - db2.data[i] * lr
        i = i + 1
    }
    i = 0
    for i < len(nn.layer1.weights.data) {
        nn.layer1.weights.data[i] = nn.layer1.weights.data[i] - dw1.data[i] * lr
        i = i + 1
    }
    i = 0
    for i < len(nn.layer1.bias.data) {
        nn.layer1.bias.data[i] = nn.layer1.bias.data[i] - db1.data[i] * lr
        i = i + 1
    }
}

pub fn Train(nn: *NeuralNetwork, x: Tensor, y: Tensor, epochs: int) {
    epoch := 0
    for epoch < epochs {
        // --- Forward pass ---
        z1 := tensor.Add(tensor.MatMul(x, nn.layer1.weights), nn.layer1.bias)
        a1 := tensor.ReLU(z1)
        
        z2 := tensor.Add(tensor.MatMul(a1, nn.layer2.weights), nn.layer2.bias)
        a2 := tensor.ReLU(z2)
        
        z3 := tensor.Add(tensor.MatMul(a2, nn.layer3.weights), nn.layer3.bias)
        a3 := tensor.Softmax(z3)
        
        // Compute integer targets for loss
        batchSize := x.Shape()[0]
        numClasses := 3
        targets := make([]int, batchSize)
        i := 0
        for i < batchSize {
            maxVal := y.data[i * numClasses]
            maxIdx := 0
            j := 1
            for j < numClasses {
                val := y.data[i * numClasses + j]
                if val > maxVal {
                    maxVal = val
                    maxIdx = j
                }
                j = j + 1
            }
            targets[i] = maxIdx
            i = i + 1
        }
        
        loss := tensor.CrossEntropyLoss(a3, targets)
        if epoch % 100 == 0 {
            print("Epoch {epoch}: Loss = {loss}")
        }
        
        // --- Backward pass ---
        dz3 := tensor.Sub(a3, y)
        dW3 := tensor.MatMul(tensor.Transpose(a2), dz3)
        db3 := sumRows(dz3)
        da2 := tensor.MatMul(dz3, tensor.Transpose(nn.layer3.weights))
        dz2 := tensor.Mul(da2, reluDeriv(z2))
        dW2 := tensor.MatMul(tensor.Transpose(a1), dz2)
        db2 := sumRows(dz2)
        da1 := tensor.MatMul(dz2, tensor.Transpose(nn.layer2.weights))
        dz1 := tensor.Mul(da1, reluDeriv(z1))
        dW1 := tensor.MatMul(tensor.Transpose(x), dz1)
        db1 := sumRows(dz1)
        
        // --- Weight updates ---
        ApplyGradients(nn, dW1, db1, dW2, db2, dW3, db3)
        
        epoch = epoch + 1
    }
}

pub fn Predict(nn: NeuralNetwork, x: Tensor) -> Tensor {
    return Forward(nn, x)
}

pub fn Accuracy(nn: NeuralNetwork, x: Tensor, y: Tensor) -> float {
    predictions := Predict(nn, x)
    
    batchSize := x.Shape()[0]
    numClasses := 3
    correct := 0
    
    i := 0
    for i < batchSize {
        maxPred := predictions.data[i * numClasses]
        predClass := 0
        j := 1
        for j < numClasses {
            val := predictions.data[i * numClasses + j]
            if val > maxPred {
                maxPred = val
                predClass = j
            }
            j = j + 1
        }
        
        maxTrue := y.data[i * numClasses]
        trueClass := 0
        k := 1
        for k < numClasses {
            val := y.data[i * numClasses + k]
            if val > maxTrue {
                maxTrue = val
                trueClass = k
            }
            k = k + 1
        }
        
        if predClass == trueClass {
            correct = correct + 1
        }
        
        i = i + 1
    }
    
    return float(correct) / float(batchSize)
}
