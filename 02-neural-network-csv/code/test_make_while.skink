module main

import "std/tensor"
import "dataset"

fn main() -> int {
    print("Loading data...")
    data, err := dataset.LoadIrisDataset("data/iris.csv")
    if err.message != "" {
        print("Failed")
        return 1
    }
    
    print("Getting batch size...")
    batchSize := data.features.Shape()[0]
    print("batchSize = {batchSize}")
    
    print("Making array...")
    targets := make([]int, batchSize)
    print("Array made")
    
    print("Assigning indices 0, 1, 2...")
    targets[0] = 0
    targets[1] = 1
    targets[2] = 2
    print("Done assigning")
    
    print("Done!")
    return 0
}
