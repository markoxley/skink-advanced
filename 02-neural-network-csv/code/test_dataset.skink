module main

import "dataset"

fn main() -> int {
    print("Loading data...")
    data, err := dataset.LoadIrisDataset("data/iris.csv")
    if err.message != "" {
        print("Failed")
        return 1
    }
    
    print("Accessing feature...")
    val := data.features.Get([0, 0])
    print("Feature [0,0] = {val}")
    
    print("Accessing label...")
    label := data.labels.Get([0, 0])
    print("Label [0,0] = {label}")
    
    print("Done!")
    return 0
}
