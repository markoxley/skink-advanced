module main

import "std/tensor"

fn main() -> int {
    a := Random([2, 3])
    sa0 := a.Shape()[0]
    sa1 := a.Shape()[1]
    print("a shape: {sa0}x{sa1}")
    v0 := a.data[0]
    v1 := a.data[1]
    print("a first 2: {v0}, {v1}")
    
    b := Random([3, 2])
    sb0 := b.Shape()[0]
    sb1 := b.Shape()[1]
    print("b shape: {sb0}x{sb1}")
    w0 := b.data[0]
    w1 := b.data[1]
    print("b first 2: {w0}, {w1}")
    
    c := MatMul(a, b)
    sc0 := c.Shape()[0]
    sc1 := c.Shape()[1]
    print("c shape: {sc0}x{sc1}")
    c0 := c.data[0]
    c1 := c.data[1]
    print("c first 2: {c0}, {c1}")
    
    t := Transpose(b)
    st0 := t.Shape()[0]
    st1 := t.Shape()[1]
    print("t shape: {st0}x{st1}")
    t0 := t.data[0]
    t1 := t.data[1]
    print("t first 2: {t0}, {t1}")
    
    print("Done!")
    return 0
}
