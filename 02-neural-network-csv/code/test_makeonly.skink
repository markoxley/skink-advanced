module main

import "dataset"

fn main() -> int {
    print("Loading data...")
    data, err := dataset.LoadIrisDataset("data/iris.csv")
    if err.message != "" {
        print("Failed")
        return 1
    }
    
    v := data.features.Get([0, 0])
    f := v + 0.0
    print("Feature = {f}")
    
    print("Making slice...")
    targets := make([]int, 15)
    targets[0] = 1
    print("targets[0] = {targets[0]}")
    
    print("Done!")
    return 0
}
