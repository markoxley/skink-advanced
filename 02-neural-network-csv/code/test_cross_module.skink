module main

import "std/tensor"
import "dataset"
import "neural_net2"

fn main() -> int {
    print("Loading data...")
    data, err := dataset.LoadIrisDataset("data/iris.csv")
    if err.message != "" {
        print("Failed")
        return 1
    }
    
    print("Setting seed...")
    tensor.SetSeed(12345)
    print("Creating NN...")
    nn := neural_net2.NewNN()
    
    print("Forward...")
    out := neural_net2.Forward(nn, data.features)
    sh := out.Shape()
    sr := sh[0]
    sc := sh[1]
    print("Output: {sr}x{sc}")
    
    print("Training...")
    neural_net2.Train(&nn, data.features, data.labels)
    print("Done!")
    return 0
}
