module main

import "std/tensor"

fn helper(nn: *LinearLayer, x: Tensor, epoch: int) {
    z1 := Add(MatMul(x, nn.weights), nn.bias)
    a1 := ReLU(z1)
    v := a1.data[0]
    
    if epoch % 100 == 0 {
        print("Epoch {epoch}: v = {v}")
    }
    
    i := 0
    for i < len(nn.weights.data) {
        nn.weights.data[i] = nn.weights.data[i] - 0.001
        i = i + 1
    }
}

fn Train(nn: *LinearLayer, x: Tensor, epochs: int) {
    epoch := 0
    for epoch < epochs {
        helper(nn, x, epoch)
        epoch = epoch + 1
    }
}

fn main() -> int {
    layer := NewLinear(4, 16)
    x := Zeros([15, 4])
    print("Training...")
    Train(&layer, x, 1000)
    print("Done!")
    return 0
}
