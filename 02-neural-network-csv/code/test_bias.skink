module main

import "std/tensor"
import "dataset"

struct NN {
    layer1: LinearLayer
}

fn main() -> int {
    print("Loading data...")
    data, err := dataset.LoadIrisDataset("data/iris.csv")
    if err.message != "" {
        print("Failed")
        return 1
    }
    
    print("Creating layer...")
    layer1 := NewLinear(4, 16)
    nn := NN{layer1: layer1}
    
    print("Computing z1...")
    z1 := Add(MatMul(data.features, nn.layer1.weights), nn.layer1.bias)
    print("z1 done")
    
    print("Computing dz1...")
    dz1 := Sub(z1, z1)
    print("dz1 done")
    
    print("Computing db1...")
    db1 := sumRows(dz1)
    print("db1 done")
    
    print("Scaling db1...")
    sdb1 := Scale(db1, 0.01)
    print("scaled")
    
    print("Sub...")
    newBias := Sub(nn.layer1.bias, sdb1)
    print("subbed")
    
    print("Assigning...")
    nn.layer1.bias = newBias
    print("assigned")
    
    print("Done!")
    return 0
}

fn sumRows(t: Tensor) -> Tensor {
    rows := t.Shape()[0]
    cols := t.Shape()[1]
    result := Zeros([1, cols])
    j := 0
    for j < cols {
        s := 0.0
        i := 0
        for i < rows {
            s = s + t.Get([i, j])
            i = i + 1
        }
        result.Set([0, j], s)
        j = j + 1
    }
    return result
}
