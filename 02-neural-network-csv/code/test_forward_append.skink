module main

import "std/tensor"
import "dataset"

struct NN {
    layer1: LinearLayer
    layer2: LinearLayer
    layer3: LinearLayer
    lr: float
}

fn NewNN() -> NN {
    return NN{
        layer1: NewLinear(4, 16),
        layer2: NewLinear(16, 8),
        layer3: NewLinear(8, 3),
        lr: 0.01
    }
}

fn Train(nn: *NN, x: Tensor, y: Tensor, epochs: int) {
    epoch := 0
    for epoch < epochs {
        z1 := Add(MatMul(x, nn.layer1.weights), nn.layer1.bias)
        a1 := ReLU(z1)
        z2 := Add(MatMul(a1, nn.layer2.weights), nn.layer2.bias)
        a2 := ReLU(z2)
        z3 := Add(MatMul(a2, nn.layer3.weights), nn.layer3.bias)
        a3 := Softmax(z3)
        
        batchSize := x.Shape()[0]
        targets := []int{}
        i := 0
        for i < batchSize {
            maxVal := y.Get([i, 0])
            maxIdx := 0
            j := 1
            for j < 3 {
                val := y.Get([i, j])
                if val > maxVal {
                    maxVal = val
                    maxIdx = j
                }
                j = j + 1
            }
            targets = append(targets, maxIdx)
            i = i + 1
        }
        
        loss := CrossEntropyLoss(a3, targets)
        if epoch % 100 == 0 {
            print("Epoch {epoch}: Loss = {loss}")
        }
        
        epoch = epoch + 1
    }
}

fn main() -> int {
    print("Loading data...")
    data, err := dataset.LoadIrisDataset("data/iris.csv")
    if err.message != "" {
        print("Failed")
        return 1
    }
    
    print("Creating NN...")
    nn := NewNN()
    
    print("Training forward only...")
    Train(&nn, data.features, data.labels, 1000)
    print("Done!")
    return 0
}
