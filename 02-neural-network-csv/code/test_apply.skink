module main

import "std/tensor"

struct NN {
    layer1: LinearLayer
    layer2: LinearLayer
    layer3: LinearLayer
    lr: float
}

fn NewNN() -> NN {
    return NN{
        layer1: NewLinear(4, 16),
        layer2: NewLinear(16, 8),
        layer3: NewLinear(8, 3),
        lr: 0.01
    }
}

fn ApplyGradients(nn: *NN, dw1: Tensor, db1: Tensor, dw2: Tensor, db2: Tensor, dw3: Tensor, db3: Tensor) {
    i := 0
    for i < len(nn.layer3.weights.data) {
        nn.layer3.weights.data[i] = nn.layer3.weights.data[i] - dw3.data[i] * nn.lr
        i = i + 1
    }
    i = 0
    for i < len(nn.layer3.bias.data) {
        nn.layer3.bias.data[i] = nn.layer3.bias.data[i] - db3.data[i] * nn.lr
        i = i + 1
    }
    i = 0
    for i < len(nn.layer2.weights.data) {
        nn.layer2.weights.data[i] = nn.layer2.weights.data[i] - dw2.data[i] * nn.lr
        i = i + 1
    }
    i = 0
    for i < len(nn.layer2.bias.data) {
        nn.layer2.bias.data[i] = nn.layer2.bias.data[i] - db2.data[i] * nn.lr
        i = i + 1
    }
    i = 0
    for i < len(nn.layer1.weights.data) {
        nn.layer1.weights.data[i] = nn.layer1.weights.data[i] - dw1.data[i] * nn.lr
        i = i + 1
    }
    i = 0
    for i < len(nn.layer1.bias.data) {
        nn.layer1.bias.data[i] = nn.layer1.bias.data[i] - db1.data[i] * nn.lr
        i = i + 1
    }
}

fn main() -> int {
    print("Creating NN...")
    nn := NewNN()
    
    dw1 := Zeros([4, 16])
    db1 := Zeros([1, 16])
    dw2 := Zeros([16, 8])
    db2 := Zeros([1, 8])
    dw3 := Zeros([8, 3])
    db3 := Zeros([1, 3])
    
    print("Applying gradients...")
    ApplyGradients(&nn, dw1, db1, dw2, db2, dw3, db3)
    print("Done!")
    return 0
}
