module main

import "std/tensor"
import "dataset"

fn reluDeriv(t: Tensor) -> Tensor {
    result := Zeros(t.shape)
    i := 0
    for i < len(t.data) {
        if t.data[i] > 0.0 {
            result.data[i] = 1.0
        }
        i = i + 1
    }
    return result
}

fn sumRows(t: Tensor) -> Tensor {
    rows := t.Shape()[0]
    cols := t.Shape()[1]
    result := Zeros([1, cols])
    j := 0
    for j < cols {
        s := 0.0
        i := 0
        for i < rows {
            s = s + t.Get([i, j])
            i = i + 1
        }
        result.Set([0, j], s)
        j = j + 1
    }
    return result
}

fn main() -> int {
    print("Loading data...")
    data, err := dataset.LoadIrisDataset("data/iris.csv")
    if err.message != "" {
        print("Failed")
        return 1
    }
    
    x := data.features
    y := data.labels
    
    W1 := Random([4, 8])
    b1 := Random([1, 8])
    W2 := Random([8, 3])
    b2 := Random([1, 3])
    lr := 0.01
    
    epoch := 0
    for epoch < 100 {
        z1 := Add(MatMul(x, W1), b1)
        a1 := ReLU(z1)
        z2 := Add(MatMul(a1, W2), b2)
        probs := Softmax(z2)
        
        loss := 0.0
        i := 0
        for i < 15 {
            target := 0
            if y.data[i * 3 + 1] > 0.5 { target = 1 }
            if y.data[i * 3 + 2] > 0.5 { target = 2 }
            p := probs.data[i * 3 + target]
            if p < 0.000001 { p = 0.000001 }
            loss = loss - math.Log(p)
            i = i + 1
        }
        loss = loss / 15.0
        
        if epoch % 20 == 0 {
            print("Ep{epoch}: {loss}")
        }
        
        dz2 := Sub(probs, y)
        dW2 := MatMul(Transpose(a1), dz2)
        db2 := sumRows(dz2)
        da1 := MatMul(dz2, Transpose(W2))
        dz1 := Mul(da1, reluDeriv(z1))
        dW1 := MatMul(Transpose(x), dz1)
        db1 := sumRows(dz1)
        
        i = 0
        for i < len(W1.data) {
            W1.data[i] = W1.data[i] - dW1.data[i] * lr
            i = i + 1
        }
        i = 0
        for i < len(b1.data) {
            b1.data[i] = b1.data[i] - db1.data[i] * lr
            i = i + 1
        }
        i = 0
        for i < len(W2.data) {
            W2.data[i] = W2.data[i] - dW2.data[i] * lr
            i = i + 1
        }
        i = 0
        for i < len(b2.data) {
            b2.data[i] = b2.data[i] - db2.data[i] * lr
            i = i + 1
        }
        
        epoch = epoch + 1
    }
    
    print("Done!")
    return 0
}
