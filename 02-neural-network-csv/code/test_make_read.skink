module main

fn main() -> int {
    print("Making array...")
    targets := make([]int, 15)
    print("Array made")
    
    print("Reading before assign...")
    v := targets[0]
    print("targets[0] = {v}")
    
    print("Assigning...")
    targets[0] = 42
    v = targets[0]
    print("targets[0] = {v}")
    
    print("Done!")
    return 0
}
