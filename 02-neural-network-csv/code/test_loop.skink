module main

import "std/tensor"

fn helper(nn: *LinearLayer) {
    i := 0
    for i < len(nn.weights.data) {
        nn.weights.data[i] = nn.weights.data[i] - 0.001
        i = i + 1
    }
}

fn Train(nn: *LinearLayer, epochs: int) {
    epoch := 0
    for epoch < epochs {
        helper(nn)
        epoch = epoch + 1
    }
}

fn main() -> int {
    layer := NewLinear(4, 16)
    print("Training...")
    Train(&layer, 1000)
    print("Done!")
    return 0
}
