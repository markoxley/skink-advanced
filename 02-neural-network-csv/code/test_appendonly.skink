module main

import "dataset"

fn main() -> int {
    print("Loading data...")
    data, err := dataset.LoadIrisDataset("data/iris.csv")
    if err.message != "" {
        print("Failed")
        return 1
    }
    
    // Just to use data
    v := data.features.Get([0, 0])
    print("Feature = {v}")
    
    print("Appending...")
    i := 0
    for i < 1000 {
        targets := []int{}
        j := 0
        for j < 15 {
            targets = append(targets, j)
            j = j + 1
        }
        i = i + 1
    }
    
    print("Done!")
    return 0
}
