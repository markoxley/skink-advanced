module main

import "std/tensor"
import "dataset"
import "neural_net"

fn main() -> int {
    print("Loading dataset...")
    data, err := dataset.LoadIrisDataset("data/iris.csv")
    if err.message != "" {
        print("Failed to load dataset")
        return 1
    }
    
    numSamples := data.features.Shape()[0]
    print("Samples: {numSamples}")
    
    nn := neural_net.NewNeuralNetwork(4, 16, 8, 3, 0.01)
    
    print("Training 1 epoch...")
    neural_net.Train(&nn, data.features, data.labels, 1)
    print("Done!")
    return 0
}
