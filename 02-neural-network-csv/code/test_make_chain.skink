module main

import "std/tensor"
import "dataset"

fn main() -> int {
    print("Loading data...")
    data, err := dataset.LoadIrisDataset("data/iris.csv")
    if err.message != "" {
        print("Failed")
        return 1
    }
    
    print("Chained...")
    batchSize := data.features.Shape()[0]
    print("batchSize = {batchSize}")
    
    print("Making array...")
    targets := make([]int, batchSize)
    print("Array made")
    
    print("Assigning...")
    targets[0] = 1
    print("Assigned")
    
    print("Done!")
    return 0
}
