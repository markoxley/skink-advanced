module main

import "std/tensor"

fn main() -> int {
    print("Creating tensors...")
    a := Zeros([1, 16])
    b := Zeros([1, 16])
    
    print("Setting values...")
    a.data[0] = 1.0
    b.data[0] = 0.5
    
    print("Sub...")
    c := Sub(a, b)
    cv := c.data[0]
    print("Sub done: {cv}")
    
    print("Scale...")
    d := Scale(b, 0.01)
    dv := d.data[0]
    print("Scale done: {dv}")
    
    print("Sub again...")
    e := Sub(a, d)
    ev := e.data[0]
    print("Sub again done: {ev}")
    return 0
}
