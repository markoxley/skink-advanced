module main

import "std/tensor"
import "dataset"

fn main() -> int {
    print("Loading data...")
    data, err := dataset.LoadIrisDataset("data/iris.csv")
    if err.message != "" {
        print("Failed")
        return 1
    }
    
    print("Getting batch size...")
    batchSize := data.features.Shape()[0]
    print("batchSize = {batchSize}")
    
    print("Making array...")
    targets := make([]int, batchSize)
    print("Array made")
    
    print("Filling array...")
    i := 0
    for i < batchSize {
        targets[i] = i % 3
        i = i + 1
    }
    print("Array filled")
    
    print("Reading back...")
    i = 0
    for i < batchSize {
        v := targets[i]
        print("targets[{i}] = {v}")
        i = i + 1
    }
    
    print("Done!")
    return 0
}
