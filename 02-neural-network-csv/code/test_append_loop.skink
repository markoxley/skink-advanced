module main

fn main() -> int {
    i := 0
    for i < 100 {
        targets := []int{}
        j := 0
        for j < 15 {
            targets = append(targets, j)
            j = j + 1
        }
        v := targets[6]
        print("i={i}, v={v}")
        i = i + 1
    }
    print("Done!")
    return 0
}
