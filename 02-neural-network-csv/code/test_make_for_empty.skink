module main

fn main() -> int {
    print("Making array...")
    targets := make([]int, 15)
    print("Array made")
    
    print("Loop...")
    i := 0
    for i < 15 {
        print("Iter {i}")
        i = i + 1
    }
    print("Loop done")
    
    v := targets[0]
    print("targets[0] = {v}")
    
    print("Done!")
    return 0
}
