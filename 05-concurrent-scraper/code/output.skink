module output

import "std/fs"
import "std/str"
import "std/fmt"

pub struct Result {
    url: string
    status: int
    title: string
    errMsg: string
    duration: int
}

pub fn SaveCSV(results: []Result, path: string) -> error {
    b := str.NewBuilder(1024)
    b.Write("URL,Status,Title,Error,Duration(ms)\n")
    for i := 0; i < len(results); i = i + 1 {
        r := results[i]
        b.Write(r.url)
        b.Write(",")
        b.Write(fmt.Itoa(r.status))
        b.Write(",")
        b.Write(r.title)
        b.Write(",")
        b.Write(r.errMsg)
        b.Write(",")
        b.Write(fmt.Itoa(r.duration))
        b.Write("\n")
    }
    return fs.WriteAll(path, b.String())
}

pub fn SaveJSON(results: []Result, path: string) -> error {
    b := str.NewBuilder(1024)
    b.Write("[\n")
    for i := 0; i < len(results); i = i + 1 {
        if i > 0 {
            b.Write(",\n")
        }
        b.Write("  {\"url\": \"")
        b.Write(results[i].url)
        b.Write("\"}")
    }
    b.Write("\n]\n")
    return fs.WriteAll(path, b.String())
}

pub fn PrintSummary(results: []Result) {
    total := len(results)
    print("\n=== Scraping Summary ===")
    print("Total URLs: {total}")
}
